import LeanWeave.Core
import Std.Sync.Mutex

namespace LeanWeave.Session

inductive SameSite where
  | strict | lax | none
  deriving BEq, Repr

structure CookieConfig where
  name : String := "__Host-weave"
  secure : Bool := true
  httpOnly : Bool := true
  sameSite : SameSite := .lax
  maxAgeSeconds : Nat := 3600

structure Data where
  id : String
  csrf : String
  expires : Nat
  values : Array (String × String) := #[]
  flash : Array (String × String) := #[]
  deriving Inhabited

structure Limits where
  maxSessions : Nat := 10000
  maxValueBytes : Nat := 16384
  maxValues : Nat := 128
  maxFlash : Nat := 32
  lifetimeMs : Nat := 3600000
  deriving Repr

/-- Shared bounded store across workers. Try-locks never block the reactor;
    contention is a retryable 503 rather than a blocking mutex acquisition. -/
structure Store where
  state : Std.Mutex (Array Data)
  limits : Limits

def Store.new (limits : Limits := {}) : IO Store := do
  if limits.maxSessions == 0 || limits.maxValueBytes == 0 || limits.maxValues == 0 || limits.maxFlash == 0 || limits.lifetimeMs == 0 then
    throw (IO.userError "invalid session bounds")
  return { state := ← Std.Mutex.new #[], limits }

/-- 256-bit opaque identifiers generated by Lean's OS CSPRNG. -/
def randomToken : IO String := do
  let bytes ← IO.getRandomBytes 32
  let digits := "0123456789abcdef".toUTF8
  let mut out := ByteArray.emptyWithCapacity 64
  for byte in bytes do
    out := out.push digits[byte.toNat / 16]! |>.push digits[byte.toNat % 16]!
  return String.fromUTF8! out

def validToken (s : String) : Bool :=
  s.utf8ByteSize == 64 && s.toUTF8.data.all (fun b => (b >= 48 && b <= 57) || (b >= 97 && b <= 102))

/-- Fixed-length constant-work comparison for CSRF tokens. -/
def tokenEquals (a b : String) : Bool := Id.run do
  if !validToken a || !validToken b then return false
  let aa := a.toUTF8
  let bb := b.toUTF8
  let mut difference : UInt8 := 0
  for i in [:64] do difference := difference ||| (aa[i]! ^^^ bb[i]!)
  return difference == 0

private def atomic (store : Store) (f : Array Data → Except AppError (α × Array Data)) : IO (Except AppError α) := do
  let result ← store.state.tryAtomically do
    let state ← get
    match f state with
    | .error error => return .error error
    | .ok (value, next) => set next; return .ok value
  return result.getD (.error { status := 503, message := "session store busy" })

def Store.get (store : Store) (id : String) (now : Nat) : IO (Except AppError (Option Data)) :=
  atomic store fun state =>
    let state := state.filter (fun s => now < s.expires)
    .ok ((state.find? fun s => s.id == id), state)

def Store.create (store : Store) (now : Nat) : IO (Except AppError Data) := do
  let id ← randomToken
  let csrf ← randomToken
  atomic store fun state => do
    let state := state.filter (fun s => now < s.expires)
    if state.size >= store.limits.maxSessions then throw { status := 503, message := "session capacity reached" }
    if state.any (fun s => s.id == id) then throw { status := 503, message := "session identifier collision" }
    let data : Data := { id, csrf, expires := now + store.limits.lifetimeMs }
    return (data, state.push data)

/-- Atomic replacement invalidates the old ID and CSRF token at login or privilege changes. -/
def Store.rotate (store : Store) (id : String) (now : Nat) : IO (Except AppError Data) := do
  let newId ← randomToken
  let csrf ← randomToken
  atomic store fun state => do
    let state := state.filter (fun s => now < s.expires)
    let some old := state.find? (fun s => s.id == id)
      | throw { status := 401, message := "session expired" }
    if state.any (fun s => s.id == newId) then throw { status := 503, message := "session identifier collision" }
    let data := { old with id := newId, csrf, expires := now + store.limits.lifetimeMs }
    return (data, (state.filter (fun s => s.id != id)).push data)

def Store.update (store : Store) (id : String) (values flash : Array (String × String))
    (now : Nat) : IO (Except AppError Unit) :=
  atomic store fun state => do
    if values.size > store.limits.maxValues || flash.size > store.limits.maxFlash then
      throw { status := 413, message := "too many session fields" }
    let bytes := (values ++ flash).foldl (fun n (k,v) => n + k.utf8ByteSize + v.utf8ByteSize) 0
    if bytes > store.limits.maxValueBytes then throw { status := 413, message := "session data too large" }
    let state := state.filter (fun s => now < s.expires)
    unless state.any (fun s => s.id == id) do throw { status := 401, message := "session expired" }
    return ((), state.map fun s => if s.id == id then { s with values, flash } else s)

/-- Atomically consume flash messages once across all workers. -/
def Store.takeFlash (store : Store) (id : String) (now : Nat) : IO (Except AppError (Array (String × String))) :=
  atomic store fun state => do
    let state := state.filter (fun s => now < s.expires)
    let some data := state.find? (fun s => s.id == id)
      | throw { status := 401, message := "session expired" }
    return (data.flash, state.map fun s => if s.id == id then { s with flash := #[] } else s)

def Store.destroy (store : Store) (id : String) : IO (Except AppError Unit) :=
  atomic store fun state => .ok ((), state.filter (fun s => s.id != id))

def cookieValue (config : CookieConfig) (id : String) : Except String String := do
  if !validToken id then throw "invalid session identifier"
  if !config.httpOnly then throw "session cookies must be HttpOnly"
  if config.name.isEmpty || !config.name.toUTF8.data.all (fun b =>
      (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45 || b == 95) then
    throw "invalid cookie name"
  if config.name.startsWith "__Host-" && !config.secure then throw "__Host- cookies require Secure"
  if config.name.startsWith "__Secure-" && !config.secure then throw "__Secure- cookies require Secure"
  if config.sameSite == .none && !config.secure then throw "SameSite=None requires Secure"
  let sameSite := match config.sameSite with | .strict => "Strict" | .lax => "Lax" | .none => "None"
  return s!"{config.name}={id}; Path=/; Max-Age={config.maxAgeSeconds}; HttpOnly; SameSite={sameSite}" ++
    (if config.secure then "; Secure" else "")

def cookieId (ctx : Context) (name : String := "__Host-weave") : Option String := do
  let raw := ctx.request.headers.filter (fun h => h.name.toLower == "cookie")
  if raw.isEmpty then none else do
  let cookieValues ← raw.mapM (fun h => String.fromUTF8? h.value)
  let cookies := String.intercalate "; " cookieValues.toList
  let foundCookies := (cookies.splitOn ";").filterMap fun entry =>
    let parts := entry.trimAscii.toString.splitOn "="
    if parts.head! == name && parts.length == 2 then some parts[1]! else none
  if foundCookies.length != 1 then none else
    let id := foundCookies.head!
    if validToken id then some id else none

end LeanWeave.Session
