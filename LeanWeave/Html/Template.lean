import LeanWeave.Html.Basic
import Lean

namespace LeanWeave.Html.Template

inductive SlotKind where
  | string | url
  deriving BEq, Repr, Inhabited

inductive Part where
  | bytes (value : String)
  | slot (name : String) (kind : SlotKind)
  deriving Repr

/-- An elaboration-time template plan. Runtime rendering uses generated byte builders. -/
structure Compiled where
  parts : Array Part := #[]
  slots : Array (String × SlotKind) := #[]
  deriving Repr

private def escaped (value : String) : String :=
  String.fromUTF8! (escapeInto ByteArray.empty value)

private def Compiled.emit (plan : Compiled) (value : String) : Compiled :=
  if value.isEmpty then plan
  else match plan.parts.back? with
    | some (.bytes last) => { plan with parts := plan.parts.pop.push (.bytes (last ++ value)) }
    | _ => { plan with parts := plan.parts.push (.bytes value) }

private def validSlotName (name : String) : Bool :=
  !name.isEmpty && name.toList.all (fun c => c.isAlphanum || c == '_')

private def Compiled.hole (plan : Compiled) (name : String) (kind : SlotKind) : Except String Compiled := do
  unless validSlotName name do throw "template slot names contain only letters, digits and underscores"
  match plan.slots.find? (fun s => s.1 == name) with
  | some (_, previous) =>
    unless previous == kind do throw s!"template slot '{name}' is used as both a URL and a string"
    return { plan with parts := plan.parts.push (.slot name kind) }
  | none => return { plan with parts := plan.parts.push (.slot name kind), slots := plan.slots.push (name, kind) }

private def containerNames : List String :=
  ["html", "head", "body", "title", "main", "header", "footer", "nav", "section", "article", "aside",
   "div", "span", "p", "a", "h1", "h2", "h3", "h4", "h5", "h6", "ul", "ol", "li", "dl", "dt", "dd",
   "form", "label", "button", "textarea", "select", "option", "fieldset", "legend", "table", "thead",
   "tbody", "tfoot", "tr", "th", "td", "caption", "strong", "em", "small", "code", "pre", "blockquote",
   "time", "details", "summary"]

private def voidNames : List String := ["input", "img", "br", "hr", "meta", "link"]

private def textAttributes : List String :=
  ["id", "class", "name", "value", "title", "type", "placeholder", "autocomplete", "role", "aria-label",
   "aria-describedby", "aria-invalid", "lang", "charset", "content", "rel", "target", "for", "method",
   "enctype", "accept", "alt", "width", "height", "scope", "datetime", "min", "max", "minlength",
   "maxlength", "pattern", "rows", "cols", "step"]

private def urlAttributes : List String := ["href", "src", "action", "formaction"]
private def boolAttributes : List String :=
  ["disabled", "checked", "selected", "required", "multiple", "readonly", "autofocus", "hidden", "open"]

private def nameChar (c : Char) : Bool :=
  (c ≥ 'a' && c ≤ 'z') || (c ≥ '0' && c ≤ '9') || c == '-'

private def parseSlot (rest : List Char) : Except String (String × List Char) := do
  let (name, tail) := rest.span (· != '}')
  match tail with
  | '}' :: '}' :: tail => return (String.ofList name, tail)
  | _ => throw "unclosed template slot; expected }}"

private partial def quotedParts (rest : List Char) (plan : Compiled) : Except String Compiled := do
  match rest with
  | [] => return plan
  | '{' :: '{' :: tail =>
    let (name, tail) ← parseSlot tail
    quotedParts tail (← plan.hole name .string)
  | _ =>
    let (literal, tail) := rest.span (· != '{')
    if literal.isEmpty then
      quotedParts rest.tail! (plan.emit "{")
    else quotedParts tail (plan.emit (escaped (String.ofList literal)))

private def urlParts (value : List Char) (plan : Compiled) : Except String Compiled := do
  match value with
  | '{' :: '{' :: tail =>
    let (name, tail) ← parseSlot tail
    unless tail.isEmpty do throw "a URL slot must occupy the complete attribute value"
    plan.hole name .url
  | _ =>
    let text := String.ofList value
    if (text.splitOn "{{").length > 1 then throw "a URL slot must occupy the complete attribute value"
    let url ← SafeUrl.parse text
    return plan.emit (escaped url.value)

private partial def attributes (rest : List Char) (plan : Compiled) (seen : List String) :
    Except String (Compiled × List Char × Bool) := do
  let tail := rest.dropWhile Char.isWhitespace
  match tail with
  | '>' :: tail => return (plan.emit ">", tail, false)
  | '/' :: '>' :: tail => return (plan.emit ">", tail, true)
  | [] => throw "unclosed opening tag"
  | _ =>
    unless tail.length < rest.length || seen.isEmpty do throw "attributes must be separated by whitespace"
    let (nameChars, afterName) := tail.span nameChar
    let name := String.ofList nameChars
    if name.isEmpty then throw "invalid attribute name"
    if seen.contains name then throw s!"duplicate attribute '{name}'"
    let afterNameRaw := afterName
    let afterName := afterName.dropWhile Char.isWhitespace
    match afterName with
    | '=' :: afterEquals =>
      let afterEquals := afterEquals.dropWhile Char.isWhitespace
      let quote :: afterQuote := afterEquals | throw "expected a quoted attribute value"
      unless quote == '"' || quote == '\'' do throw "attribute values must be quoted"
      let (value, afterValue) := afterQuote.span (· != quote)
      let _ :: afterValue := afterValue | throw "unclosed attribute value"
      let plan := plan.emit s!" {name}=\""
      let plan ← if textAttributes.contains name then quotedParts value plan
        else if urlAttributes.contains name then urlParts value plan
        else throw s!"attribute '{name}' is not allowed"
      attributes afterValue (plan.emit "\"") (name :: seen)
    | _ =>
      unless boolAttributes.contains name do throw s!"attribute '{name}' requires a quoted value"
      attributes afterNameRaw (plan.emit s!" {name}") (name :: seen)

private partial def scan (rest : List Char) (stack : List String) (plan : Compiled) : Except String Compiled := do
  match rest with
  | [] =>
    unless stack.isEmpty do throw s!"unclosed template tag '{stack.head!}'"
    return plan
  | '{' :: '{' :: tail =>
    let (name, tail) ← parseSlot tail
    scan tail stack (← plan.hole name .string)
  | '<' :: '/' :: tail =>
    let (nameChars, tail) := tail.span nameChar
    let name := String.ofList nameChars
    let '>' :: tail := tail.dropWhile Char.isWhitespace | throw "invalid closing tag"
    let openName :: stack := stack | throw s!"unexpected closing tag '{name}'"
    unless name == openName do throw s!"closing tag '{name}' does not match '{openName}'"
    scan tail stack (plan.emit s!"</{name}>")
  | '<' :: tail =>
    let (nameChars, tail) := tail.span nameChar
    let name := String.ofList nameChars
    unless containerNames.contains name || voidNames.contains name do
      throw s!"tag '{name}' is not allowed; use rawUnsafe only for audited trusted HTML"
    let (plan, tail, closed) ← attributes tail (plan.emit s!"<{name}") []
    if voidNames.contains name then scan tail stack plan
    else if closed then throw "container tags require an explicit closing tag"
    else scan tail (name :: stack) plan
  | _ =>
    let (literal, tail) := rest.span (fun c => c != '<' && c != '{')
    if literal.isEmpty then scan rest.tail! stack (plan.emit "{")
    else scan tail stack (plan.emit (escaped (String.ofList literal)))

/-- Parse a restricted HTML template. Dynamic slots are escaped and may appear
only in text or quoted attributes. URL slots consume a SafeUrl argument.
The `html!` elaborator runs this function during compilation, rejecting bad markup. -/
def compile (source : String) : Except String Compiled := scan source.toList [] {}

end LeanWeave.Html.Template

open Lean Elab Term in
/-- Compile checked HTML markup to a function whose arguments follow the first
appearance of each {{slot}}. Text/attribute slots have type String; URL slots
have type SafeUrl. Static fragments are emitted as closed ByteArray constants. -/
elab "html!" source:str : term => do
  let plan ← match LeanWeave.Html.Template.compile source.getString with
    | .ok plan => pure plan
    | .error message => throwErrorAt source "{message}"
  let identifiers := plan.slots.mapIdx fun i _ => Lean.mkIdent (Lean.Name.mkSimple s!"__weave_slot_{i}")
  let mut body ← `(ByteArray.empty)
  for part in plan.parts do
    match part with
    | .bytes value =>
      let bytes ← value.toUTF8.data.mapM fun b => `($(Lean.quote b.toNat).toUInt8)
      body ← `(($body).append (ByteArray.mk #[$bytes,*]))
    | .slot name kind =>
      let some index := plan.slots.findIdx? (fun s => s.1 == name) | throwError "missing compiled slot"
      let ident := identifiers[index]!
      let value ← if kind == .url then `(($ident).value) else `($ident)
      body ← `(LeanWeave.Html.escapeInto $body $value)
  let mut result ← `(LeanWeave.Html.rawUnsafe $body)
  for index in (List.range plan.slots.size).reverse do
    let ident := identifiers[index]!
    let type ← if plan.slots[index]!.2 == .url then `(LeanWeave.Html.SafeUrl) else `(String)
    result ← `(fun ($ident : $type) => $result)
  elabTerm result none
